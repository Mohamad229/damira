    {
      "id": "N6h-wc4zuu3v9Mv81JujL",
      "type": "text",
      "x": -3102.979799671437,
      "y": 783.0465109022539,
      "width": 4030.240384851872,
      "height": 1111.8000354766846,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
